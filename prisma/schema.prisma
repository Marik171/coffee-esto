datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Order {
  id                String      @id
  email             String
  fullName          String      @default("")
  locale            String      @default("tr")
  phone             String      @default("")
  address           String
  paymentId         String      @default("")
  subtotal          Float
  shippingFee       Float
  cargoProviderName String      @default("")
  couponCode        String      @default("")
  discountAmount    Float       @default(0)
  totalAmount       Float
  status            String      @default("pending")
  paymentStatus     String      @default("awaiting")
  fulfillmentStatus String      @default("not_fulfilled")
  trackingNumber    String      @default("")
  shippingProvider  String      @default("")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  items             OrderItem[]
  customerId        String?
  customer          Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([customerId])
}

// Singleton row (id always 1) toggling whether checkout charges shipping at all.
model ShippingSettings {
  id      Int     @id @default(1)
  enabled Boolean @default(false)
}

model CargoProvider {
  id        String   @id @default(uuid())
  name      String
  fee       Float
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id       String @id @default(uuid())
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  coffeeId String
  name     String
  quantity Int
  price    Float
}

model Product {
  id           String   @id
  name         String
  category     String
  origin       String
  altitude     String
  varietal     String
  roastLevel   Int
  tastingNotes String
  description  String
  price        Float
  price1kg     Float    @default(0)
  wholesalePrice Float   @default(0.0)
  stock        Int      @default(0)
  imageUrl     String   @default("")
  videoUrl     String   @default("")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Percent- or fixed-amount discount codes, redeemable at checkout.
model Coupon {
  id             String    @id @default(uuid())
  code           String    @unique
  type           String    // "percent" | "fixed"
  value          Float     // percent (0-100) or fixed TRY amount
  minOrderAmount Float     @default(0)
  maxUses        Int?      // null = unlimited
  usedCount      Int       @default(0)
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// Snapshot of a checkout-in-progress cart, captured once an email is known.
// A scheduled job emails a reminder if it's never converted into an Order.
model AbandonedCart {
  id             String    @id @default(uuid())
  email          String
  name           String    @default("")
  items          Json
  subtotal       Float
  locale         String    @default("tr")
  reminderSentAt DateTime?
  recovered      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([email])
}

model Category {
  id        String   @id @default(uuid())
  slug      String   @unique
  label     String
  createdAt DateTime @default(now())
}

model Customer {
  id                String          @id @default(uuid())
  email             String          @unique
  name              String          @default("")
  phone             String          @default("")
  newsOptIn         Boolean         @default(true)
  iyzicoCardUserKey String?
  isSubscriber      Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  addresses         Address[]
  orders            Order[]
  paymentMethods    PaymentMethod[]
  reviews           Review[]
}

model LoginCode {
  id         String    @id @default(uuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([email])
}

model Address {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  fullName   String
  address    String
  city       String
  zipCode    String
  phone      String   @default("")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId])
}

// Stores only iyzico's tokenized card reference + display metadata.
// Raw PAN/CVC never touch our database — they're sent straight to iyzico's
// card-storage endpoint and discarded server-side after the token comes back.
model PaymentMethod {
  id              String   @id @default(uuid())
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  cardToken       String
  cardAlias       String   @default("")
  lastFourDigits  String
  cardAssociation String   @default("")
  cardFamily      String   @default("")
  cardBankName    String   @default("")
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([customerId])
}

model BlogPost {
  id        String   @id @default(uuid())
  titleEn   String   @default("")
  titleTr   String   @default("")
  contentEn String   @default("")
  contentTr String   @default("")
  category  String   // e.g. "news", "updates", "guides", "culture", etc.
  imageUrl  String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Product reviews — one review per customer per product (upsert on re-submit).
model Review {
  id         String   @id @default(uuid())
  productId  String
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rating     Int      // 1–5
  title      String   @default("")
  body       String
  isHidden   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([productId, customerId])
  @@index([productId])
  @@index([customerId])
}

model EmailSettings {
  id            Int      @id @default(1)
  provider      String   @default("smtp")
  smtpHost      String   @default("smtp.mailtrap.io")
  smtpPort      Int      @default(587)
  smtpUser      String   @default("")
  smtpPass      String   @default("")
  fromEmail     String   @default("orders@grainandgrind.com")
  fromName      String   @default("Coffee Esto Roastery")
  resendApiKey  String   @default("")
  templatesJson String   @default("{}")
  updatedAt     DateTime @updatedAt
}

model StorefrontSettings {
  id                  Int      @id @default(1)
  announcementEnabled Boolean  @default(true)
  announcementTextTr  String   @default("☕ 2.000 TL ve üzeri tüm siparişlerde Kargo ÜCRETSİZ!")
  announcementTextEn  String   @default("☕ Free Shipping on all orders over ₺2,000!")
  announcementBg      String   @default("linear-gradient(90deg, #2a170c 0%, #4a2817 100%)")
  announcementLink    String   @default("/coffee")
  spotlightProductId  String   @default("ethiopia")
  holidayModeEnabled  Boolean  @default(false)
  holidayNoticeTr     String   @default("")
  holidayNoticeEn     String   @default("")
  updatedAt           DateTime @updatedAt
}

